<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlgorithmPractice1.GUI.ViewModels"
             xmlns:models="clr-namespace:AlgorithmPractice1.GUI.Models"
             xmlns:cmodels="clr-namespace:AlgorithmPractice1.Core.Models;assembly=AlgorithmPractice1.Core"
             x:Class="AlgorithmPractice1.GUI.Views.ExperimentProgressView"
             x:DataType="vm:ExperimentProgressViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- 1. Верхняя панель: Общий статус очереди и управление -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="📋 Очередь выполнения пакетов"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1F2328" />
                    <TextBlock Text="{Binding QueueSummary}"
                               FontSize="13"
                               Foreground="#57606A" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="🧹 Очистить завершённые"
                            Command="{Binding ClearCompletedBatchesCommand}"
                            FontSize="12"
                            Padding="10,6" />
                    <Button Content="📊 К результатам"
                            Command="{Binding GoToResultsCommand}"
                            Background="#0969DA"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Пустое состояние (когда нет пакетов) -->
        <Border Grid.Row="1"
                IsVisible="{Binding !HasBatches}"
                Background="White"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="⏳" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="Нет запущенных пакетов"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1F2328"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Выберите алгоритмы во вкладке 'Настройка' и нажмите 'Запустить эксперимент'."
                           FontSize="13"
                           Foreground="#57606A"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 3. Список запущенных пакетов, идущих друг под другом -->
        <ScrollViewer Grid.Row="1"
                      IsVisible="{Binding HasBatches}"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Batches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:BatchProgressItemViewModel">
                        <Border Background="White"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,14">
                            <StackPanel Spacing="12">
                                <!-- Шапка пакета -->
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!-- Бейдж статуса -->
                                    <Border Grid.Column="0"
                                            Background="{Binding BadgeBackground}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="{Binding BadgeForeground}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <!-- Название пакета и статусная строка -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding SessionLabel}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#1F2328" />
                                        <TextBlock Text="{Binding StatusSummary}"
                                                   FontSize="12"
                                                   Foreground="#656D76" />
                                    </StackPanel>

                                    <!-- Счетчик N/M -->
                                    <Border Grid.Column="2"
                                            Background="#F6F8FA"
                                            BorderBrush="#D0D7DE"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FractionText}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#0969DA" />
                                    </Border>
                                </Grid>

                                <!-- Прогресс-бар пакета -->
                                <ProgressBar Height="8"
                                             Value="{Binding Percentage}"
                                             Minimum="0"
                                             Maximum="100" />

                                <!-- Список алгоритмов внутри данного пакета -->
                                <Expander Header="Подробный список алгоритмов пакета"
                                          IsExpanded="True"
                                          Background="#FAFBFC"
                                          BorderBrush="#E1E4E8"
                                          BorderThickness="1"
                                          CornerRadius="6">
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="cmodels:AlgorithmProgressItem">
                                                <Border BorderBrush="#E1E4E8"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,6">
                                                    <Grid ColumnDefinitions="36, 220, 160, *">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding StatusIcon}"
                                                                   FontSize="16"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AlgorithmName}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1F2328"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding StatusDisplayName}"
                                                                   FontWeight="Medium"
                                                                   Foreground="#0969DA"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Details}"
                                                                   FontSize="12"
                                                                   Foreground="#656D76"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
