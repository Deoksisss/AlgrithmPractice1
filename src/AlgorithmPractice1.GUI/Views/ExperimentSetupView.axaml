<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlgorithmPractice1.GUI.ViewModels"
             xmlns:models="clr-namespace:AlgorithmPractice1.GUI.Models"
             x:Class="AlgorithmPractice1.GUI.Views.ExperimentSetupView"
             x:DataType="vm:ExperimentSetupViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="14">

            <!-- 1. Верхняя карточка: Общие параметры эксперимента -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="⚙️ Общие параметры эксперимента"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1F2328" />
                            <TextBlock Text="Задайте параметры один раз — они автоматически применятся ко всем выбранным алгоритмам при запуске."
                                       FontSize="12"
                                       Foreground="#656D76" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="↺ Сбросить к рекомендованным"
                                Command="{Binding ResetCommonDefaultsCommand}"
                                FontSize="12"
                                Padding="10,5"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Separator Height="1" Background="#E1E4E8" />

                    <!-- Сетка полей ввода основных параметров -->
                    <Grid ColumnDefinitions="*, *, *, *, *">
                        <!-- NMax -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Максимальный N:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonNMax}"
                                           Minimum="1"
                                           Maximum="2000000"
                                           FormatString="F0" />
                            <TextBlock Text="Верхняя граница N (и M)" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- NStep -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Шаг по N:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonNStep}"
                                           Minimum="1"
                                           Maximum="500000"
                                           FormatString="F0" />
                            <TextBlock Text="Интервал точек сетки" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- RunsPerN -->
                        <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Повторов на точку:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonRunsPerN}"
                                           Minimum="1"
                                           Maximum="50"
                                           FormatString="F0" />
                            <TextBlock Text="Для усреднения времени" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- CommonK -->
                        <StackPanel Grid.Column="3" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Раундов K (Миллер-Рабин):" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonK}"
                                           Minimum="1"
                                           Maximum="200"
                                           FormatString="F0" />
                            <TextBlock Text="Число раундов теста" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- CommonX -->
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="Основание X (степень/полином):" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonX}"
                                           Increment="0.1"
                                           FormatString="F2" />
                            <TextBlock Text="Основание x^n и полинома" FontSize="10" Foreground="#656D76" />
                        </StackPanel>
                    </Grid>

                    <!-- Нижняя строка карточки настроек -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding CommonForceRecalculate}"
                                  Content="Принудительный пересчёт (игнорировать кэш SQLite)"
                                  FontSize="12"
                                  VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Background="#F0F8FF"
                                BorderBrush="#B6E3FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="16,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="💡 Матричное умножение: N и M изменяются одинаково [Шаг..N] × [Шаг..N] для построения 3D поверхности."
                                       FontSize="11"
                                       Foreground="#0969DA" />
                        </Border>

                        <Button Grid.Column="2"
                                Content="📋 Применить ко всем алгоритмам в списке"
                                Command="{Binding ApplyCommonToAllCommand}"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Выбор алгоритмов (Компактный 2-колоночный интерфейс) -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🔬 Исследуемые алгоритмы"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1F2328" />
                            <Border Background="#EBF5FF" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding SelectedCountText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#0969DA" />
                            </Border>
                        </StackPanel>

                        <!-- Кнопки быстрого выбора категорий -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Выбрать все"
                                    Command="{Binding SelectAllCommand}"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Снять выбор"
                                    Command="{Binding DeselectAllCommand}"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Separator Width="1" Background="#E1E4E8" Margin="4,0" />
                            <Button Content="Векторы"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Vectors"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Матрицы"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Matrices"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Теория чисел"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Individual"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Степени"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Exponentiation"
                                    FontSize="11"
                                    Padding="8,4" />
                        </StackPanel>
                    </Grid>

                    <Separator Height="1" Background="#E1E4E8" />

                    <!-- 2-колоночная сетка категорий -->
                    <Grid ColumnDefinitions="*, *">
                        <!-- Левая колонка: Векторы (8 алгоритмов) -->
                        <Border Grid.Column="0"
                                Background="#F6F8FA"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0"
                                               Text="🔷 Часть I. Векторы (8 алгоритмов)"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#0969DA" />
                                    <TextBlock Grid.Column="1"
                                               Text="Метрика: время (мс)"
                                               FontSize="10"
                                               Foreground="#656D76" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding VectorAlgorithms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AlgorithmSelectionItem">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      Margin="0,3"
                                                      HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Algorithm.DisplayName}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            Background="#E1E4E8"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ComplexityDisplayName}"
                                                                   FontSize="10"
                                                                   Foreground="#57606A" />
                                                    </Border>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Правая колонка: Матрицы, Индивидуальные, Возведение в степень -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
                            <!-- Матрицы -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="🔶 Часть II. Матрицы (3D график)"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#BF8700" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Метрика: время (мс)"
                                                   FontSize="10"
                                                   Foreground="#656D76" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding MatrixAlgorithms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlgorithmSelectionItem">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Algorithm.DisplayName}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                Background="#E1E4E8"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="3D, O(n²·m)"
                                                                       FontSize="10"
                                                                       Foreground="#57606A" />
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Размерности N и M меняются одинаково (от шага до N_max)."
                                               FontSize="10"
                                               Foreground="#656D76"
                                               Margin="24,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Индивидуальные -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="🟣 Часть III. Индивидуальные алгоритмы (3)"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#8250DF" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Метрика: время (мс)"
                                                   FontSize="10"
                                                   Foreground="#656D76" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding IndividualAlgorithms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlgorithmSelectionItem">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Algorithm.DisplayName}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                Background="#E1E4E8"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ComplexityDisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="#57606A" />
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Степени -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="🟢 Часть IV. Возведение в степень (3)"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#1A7F37" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Метрика: шаги (число умножений)"
                                                   FontSize="10"
                                                   Foreground="#1A7F37" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ExponentiationAlgorithms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlgorithmSelectionItem">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Algorithm.DisplayName}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                Background="#E1E4E8"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ComplexityDisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="#57606A" />
                                                        </Border>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Индивидуальная настройка параметров алгоритмов (опциональный экспандер) -->
            <Expander Header="🛠️ Индивидуальная настройка параметров алгоритмов (нажмите для раскрытия)"
                      Background="White"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel Spacing="12">
                    <CheckBox IsChecked="{Binding UseIndividualSettings}"
                              Content="Использовать индивидуальные настройки алгоритмов вместо общих"
                              FontWeight="SemiBold" />

                    <Separator Height="1" Background="#E1E4E8" />

                    <!-- Выбор алгоритма для индивидуальной калибровки -->
                    <Grid ColumnDefinitions="160, *">
                        <TextBlock Grid.Column="0"
                                   Text="Выбрать алгоритм:"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Algorithms}"
                                  SelectedItem="{Binding SelectedIndividualAlgorithm}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AlgorithmSelectionItem">
                                    <TextBlock Text="{Binding Algorithm.DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Панель индивидуальных параметров выбранного алгоритма -->
                    <Border Background="#F6F8FA"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            DataContext="{Binding SelectedIndividualAlgorithm}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Algorithm.DisplayName}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#1F2328" />

                            <TextBlock Text="{Binding Algorithm.Description}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#57606A" />

                            <Grid ColumnDefinitions="200, 160">
                                <TextBlock Grid.Column="0" Text="Максимальный N:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding NMax}" Minimum="1" Maximum="2000000" FormatString="F0" />
                            </Grid>

                            <Grid ColumnDefinitions="200, 160">
                                <TextBlock Grid.Column="0" Text="Шаг по N:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding NStep}" Minimum="1" Maximum="500000" FormatString="F0" />
                            </Grid>

                            <Grid ColumnDefinitions="200, 160">
                                <TextBlock Grid.Column="0" Text="Число повторов на N:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding RunsPerN}" Minimum="1" Maximum="50" FormatString="F0" />
                            </Grid>

                            <!-- Карточка для матриц -->
                            <Border Background="#F0F8FF" BorderBrush="#B6E3FF" BorderThickness="1" CornerRadius="4" Padding="8,6" IsVisible="{Binding HasM}">
                                <TextBlock Text="ℹ️ Размеры матрицы: n и m синхронизированы (M = NMax, MStep = NStep)." FontSize="11" Foreground="#0969DA" />
                            </Border>

                            <!-- K для Миллера-Рабина -->
                            <Grid ColumnDefinitions="200, 160" IsVisible="{Binding HasK}">
                                <TextBlock Grid.Column="0" Text="Число раундов K:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding K}" Minimum="1" Maximum="200" FormatString="F0" />
                            </Grid>

                            <!-- X для степени / полинома -->
                            <Grid ColumnDefinitions="200, 160" IsVisible="{Binding HasX}">
                                <TextBlock Grid.Column="0" Text="Основание / аргумент X:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding X}" Increment="0.1" FormatString="F4" />
                            </Grid>

                            <CheckBox IsChecked="{Binding ForceRecalculate}"
                                      Content="Принудительный пересчёт (игнорировать кэш БД)" />

                            <Button Content="Сбросить этот алгоритм к рекомендованным"
                                    Command="{Binding ResetToDefaults}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- 4. Нижняя панель запуска -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Название сессии (опционально):"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   Foreground="#57606A"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SessionLabel}"
                                 Watermark="Например: Калибровочный прогон #1" />
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1"
                            Command="{Binding RunExperimentCommand}"
                            Background="#1F883D"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Padding="24,12"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚀" />
                            <TextBlock Text="Запустить эксперимент" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding ErrorMessage}"
                               Foreground="#CF222E"
                               FontWeight="Medium"
                               Margin="0,8,0,0"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
