<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlgorithmPractice1.GUI.ViewModels"
             xmlns:models="clr-namespace:AlgorithmPractice1.GUI.Models"
             x:Class="AlgorithmPractice1.GUI.Views.ExperimentSetupView"
             x:DataType="vm:ExperimentSetupViewModel">

    <UserControl.Resources>
        <!-- Единый шаблон элемента алгоритма с разворачиваемой стрелкой индивидуальных настроек -->
        <DataTemplate x:Key="AlgorithmItemTemplate" x:DataType="models:AlgorithmSelectionItem">
            <Border Background="White"
                    BorderBrush="#E1E4E8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,2"
                    Padding="6,4">
                <StackPanel Spacing="4">
                    <!-- Заголовок элемента: Чекбокс, Название, Метка кастомизации, Сложность, Стрелка -->
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Algorithm.DisplayName}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#1F2328"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Бейдж кастомных настроек -->
                        <Border Grid.Column="2"
                                Background="#FFF8C5"
                                BorderBrush="#D4A72C"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="4,1"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding UseCustomSettings}">
                            <TextBlock Text="Кастомные"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9A6700" />
                        </Border>

                        <!-- Бейдж сложности -->
                        <Border Grid.Column="3"
                                Background="#E1E4E8"
                                CornerRadius="3"
                                Padding="4,1"
                                Margin="4,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ComplexityDisplayName}"
                                       FontSize="10"
                                       Foreground="#57606A" />
                        </Border>

                        <!-- Разворачиваемая стрелка -->
                        <ToggleButton Grid.Column="4"
                                      Classes="expanderToggle"
                                      IsChecked="{Binding IsExpanded}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"
                                      ToolTip.Tip="Индивидуальные настройки алгоритма">
                            <Panel>
                                <TextBlock Text="▼" FontSize="10" Foreground="#57606A" IsVisible="{Binding !IsExpanded}" />
                                <TextBlock Text="▲" FontSize="10" Foreground="#0969DA" IsVisible="{Binding IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                    </Grid>

                    <!-- Выпадающая панель индивидуальных настроек -->
                    <Border IsVisible="{Binding IsExpanded}"
                            Background="#F6F8FA"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,4,0,2"
                            Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚙️ Индивидуальные параметры алгоритма"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#1F2328" />

                            <!-- Специфический параметр K для Миллера-Рабина -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasK}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Число раундов K (тест Миллера-Рабина):"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="#1F2328" />
                                        <TextBlock Text="Вероятность ошибки не более 4^(-k). Настраивается индивидуально."
                                                   FontSize="10"
                                                   Foreground="#656D76" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding K}"
                                                   Minimum="1"
                                                   Maximum="200"
                                                   FormatString="F0"
                                                   Width="90"
                                                   Height="28" />
                                </Grid>
                                <Separator Height="1" Background="#E1E4E8" Margin="0,4" />
                            </StackPanel>

                            <!-- Переключатель использования индивидуальных NMax/шага/повторов -->
                            <CheckBox IsChecked="{Binding UseCustomSettings}"
                                      Content="Использовать индивидуальные NMax, шаг и повторы"
                                      FontSize="11"
                                      FontWeight="SemiBold" />

                            <!-- Если индивидуальные параметры включены -->
                            <StackPanel IsVisible="{Binding UseCustomSettings}" Spacing="6">
                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                        <TextBlock Text="Макс. N:" FontSize="11" FontWeight="Medium" />
                                        <NumericUpDown Value="{Binding NMax}" Minimum="1" Maximum="2000000" FormatString="F0" Height="28" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,6,0">
                                        <TextBlock Text="Шаг по N:" FontSize="11" FontWeight="Medium" />
                                        <NumericUpDown Value="{Binding NStep}" Minimum="1" Maximum="500000" FormatString="F0" Height="28" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Повторов:" FontSize="11" FontWeight="Medium" />
                                        <NumericUpDown Value="{Binding RunsPerN}" Minimum="1" Maximum="50" FormatString="F0" Height="28" />
                                    </StackPanel>
                                </Grid>

                                <!-- Если это матричное умножение -->
                                <Border Background="#F0F8FF"
                                        BorderBrush="#B6E3FF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,4"
                                        IsVisible="{Binding HasM}">
                                    <TextBlock Text="ℹ️ Размеры матрицы: N и M синхронизированы (M = NMax, MStep = NStep)."
                                               FontSize="10"
                                               Foreground="#0969DA" />
                                </Border>

                                <!-- Если это полином или степень -->
                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding HasX}">
                                    <TextBlock Grid.Column="0" Text="Основание / аргумент X:" FontSize="11" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding X}" Increment="0.1" FormatString="F2" Width="90" Height="28" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding ForceRecalculate}"
                                              Content="Принудительный пересчёт (без кэша БД)"
                                              FontSize="11"
                                              VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="↺ К рекомендованным"
                                            Command="{Binding ResetDefaultsCommand}"
                                            FontSize="10"
                                            Padding="6,3" />
                                </Grid>
                            </StackPanel>

                            <!-- Подсказка, когда индивидуальные выключены -->
                            <TextBlock IsVisible="{Binding !UseCustomSettings}"
                                       Text="Сейчас для NMax, шага и повторов действуют общие параметры сверху."
                                       FontSize="10"
                                       Foreground="#656D76"
                                       FontStyle="Italic"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ToggleButton.expanderToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.expanderToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EAEEF2" />
        </Style>
        <Style Selector="ToggleButton.expanderToggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDF4FF" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="14">

            <!-- 1. Верхняя карточка: Общие параметры эксперимента -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="⚙️ Общие параметры эксперимента"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1F2328" />
                            <TextBlock Text="Задайте параметры один раз — они автоматически применятся ко всем выбранным алгоритмам при запуске."
                                       FontSize="12"
                                       Foreground="#656D76" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="↺ Сбросить к рекомендованным"
                                Command="{Binding ResetCommonDefaultsCommand}"
                                FontSize="12"
                                Padding="10,5"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Separator Height="1" Background="#E1E4E8" />

                    <!-- Сетка полей ввода основных параметров (4 колонки) -->
                    <Grid ColumnDefinitions="*, *, *, *">
                        <!-- NMax -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Максимальный N:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonNMax}"
                                           Minimum="1"
                                           Maximum="2000000"
                                           FormatString="F0" />
                            <TextBlock Text="Верхняя граница N (и M)" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- NStep -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Шаг по N:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonNStep}"
                                           Minimum="1"
                                           Maximum="500000"
                                           FormatString="F0" />
                            <TextBlock Text="Интервал точек сетки" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- RunsPerN -->
                        <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,10,0">
                            <TextBlock Text="Повторов на точку:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonRunsPerN}"
                                           Minimum="1"
                                           Maximum="50"
                                           FormatString="F0" />
                            <TextBlock Text="Для усреднения времени" FontSize="10" Foreground="#656D76" />
                        </StackPanel>

                        <!-- CommonX -->
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Основание X (степень/полином):" FontWeight="SemiBold" FontSize="12" Foreground="#1F2328" />
                            <NumericUpDown Value="{Binding CommonX}"
                                           Increment="0.1"
                                           FormatString="F2" />
                            <TextBlock Text="Основание x^n и полинома" FontSize="10" Foreground="#656D76" />
                        </StackPanel>
                    </Grid>

                    <!-- Нижняя строка карточки настроек -->
                    <Grid ColumnDefinitions="*, Auto">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding CommonForceRecalculate}"
                                  Content="Принудительный пересчёт (игнорировать кэш SQLite)"
                                  FontSize="12"
                                  VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="📋 Применить ко всем алгоритмам в списке"
                                Command="{Binding ApplyCommonToAllCommand}"
                                FontSize="11"
                                Padding="8,4"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Выбор алгоритмов (Компактный 2-колоночный интерфейс с разворачиваемыми стрелками) -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🔬 Исследуемые алгоритмы"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1F2328" />
                            <Border Background="#EBF5FF" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding SelectedCountText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#0969DA" />
                            </Border>
                        </StackPanel>

                        <!-- Кнопки быстрого выбора категорий -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Выбрать все"
                                    Command="{Binding SelectAllCommand}"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Снять выбор"
                                    Command="{Binding DeselectAllCommand}"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Separator Width="1" Background="#E1E4E8" Margin="4,0" />
                            <Button Content="Векторы"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Vectors"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Матрицы"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Matrices"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Теория чисел"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Individual"
                                    FontSize="11"
                                    Padding="8,4" />
                            <Button Content="Степени"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="Exponentiation"
                                    FontSize="11"
                                    Padding="8,4" />
                        </StackPanel>
                    </Grid>

                    <Separator Height="1" Background="#E1E4E8" />

                    <!-- 2-колоночная сетка категорий -->
                    <Grid ColumnDefinitions="*, *">
                        <!-- Левая колонка: Векторы -->
                        <Border Grid.Column="0"
                                Background="#F6F8FA"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Векторы"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#0969DA"
                                           Margin="0,0,0,4" />

                                <ItemsControl ItemsSource="{Binding VectorAlgorithms}"
                                              ItemTemplate="{StaticResource AlgorithmItemTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Правая колонка: Матрицы, Индивидуальные, Возведение в степень -->
                        <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
                            <!-- Матрицы -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Матрицы"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#BF8700" />

                                    <ItemsControl ItemsSource="{Binding MatrixAlgorithms}"
                                                  ItemTemplate="{StaticResource AlgorithmItemTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- Индивидуальные алгоритмы -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Индивидуальные алгоритмы"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#8250DF" />

                                    <ItemsControl ItemsSource="{Binding IndividualAlgorithms}"
                                                  ItemTemplate="{StaticResource AlgorithmItemTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- Возведение в степень -->
                            <Border Background="#F6F8FA"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Возведение в степень"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#1A7F37" />

                                    <ItemsControl ItemsSource="{Binding ExponentiationAlgorithms}"
                                                  ItemTemplate="{StaticResource AlgorithmItemTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Нижняя панель запуска -->
            <Border Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Название сессии (опционально):"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   Foreground="#57606A"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SessionLabel}"
                                 Watermark="Например: Калибровочный прогон #1" />
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1"
                            Command="{Binding RunExperimentCommand}"
                            Background="#1F883D"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Padding="24,12"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚀" />
                            <TextBlock Text="Запустить эксперимент" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding ErrorMessage}"
                               Foreground="#CF222E"
                               FontWeight="Medium"
                               Margin="0,8,0,0"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
